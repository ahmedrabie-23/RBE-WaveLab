---
import { href } from '../lib/paths';
interface Props { items: { title: string; path: string }[]; } const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs"><ol><li><a href={href()}>Home</a></li>{items.map((i,index)=><li>{index===items.length-1?<span aria-current="page">{i.title}</span>:<a href={href(i.path)}>{i.title}</a>}</li>)}</ol></nav>
