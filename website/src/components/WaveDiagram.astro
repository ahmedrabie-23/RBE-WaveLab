---
interface Props { id?: string; mode?: string; }
const {id='concept-wave',mode='wave-propagation'}=Astro.props;
const travel=mode==='wave-propagation',standing=mode==='standing-waves-vswr',reflection=mode==='reflection-coefficient',decay=!travel&&!standing&&!reflection;
const title=travel?'Conceptual forward traveling wave':standing?'Fixed nodes in an ideal standing-wave pattern':reflection?'Forward and reflected voltage components':'Forward amplitude attenuation on a uniform line';
const description=travel?'A uniform lossless traveling-wave illustration. Optional phase motion is not numerical WaveLab output.':standing?'Equal opposite waves produce fixed nodes. This static curve is one instantaneous phase, not a simulated measurement.':reflection?'Direction arrows identify incident and reflected voltage components at a termination; they do not specify a power ratio.':'A decaying envelope bounds a forward-wave illustration. Total reflected voltage need not decrease monotonically.';
const points=Array.from({length:travel?401:241},(_,k)=>{const i=travel?k-80:k,x=i*3,envelope=decay?Math.exp(-x/900):1;return `${k===0?'M':'L'}${x},${100-45*envelope*Math.sin(i/240*Math.PI*6)}`;}).join(' ');
const envelope=(sign:number)=>Array.from({length:241},(_,i)=>`${i===0?'M':'L'}${i*3},${100+sign*45*Math.exp(-i*3/900)}`).join(' ');
---
<figure class="wave-card"><svg id={id} viewBox="0 0 720 200" role="img" aria-labelledby={`${id}-title ${id}-desc`} data-playing="false"><title id={`${id}-title`}>{title}</title><desc id={`${id}-desc`}>{description}</desc><defs><clipPath id={`${id}-clip`}><rect x="0" y="20" width="720" height="155"/></clipPath><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor"/></marker></defs><path d="M0 100H720M20 30V175" class="diagram-axis"/>
{reflection?<g class="diagram-components"><path d="M90 65H580M580 140H90" stroke="currentColor" stroke-width="2" marker-end={`url(#${id}-arrow)`}/><path d="M630 40V165" class="diagram-axis"/><text x="110" y="52">Incident voltage →</text><text x="110" y="165">← Reflected voltage</text><text x="645" y="110">Load</text></g>:<g clip-path={`url(#${id}-clip)`}>{decay&&<><path d={envelope(-1)} class="diagram-axis" stroke-dasharray="5 5"/><path d={envelope(1)} class="diagram-axis" stroke-dasharray="5 5"/></>}<path d={points} class={travel?'diagram-wave':'diagram-static'}/>{standing&&[0,1,2,3,4,5,6].map(n=><circle cx={n*120} cy="100" r="4" fill="currentColor"/>)}</g>}
<text x="28" y="28">{reflection?'Voltage-wave directions':decay?'Forward voltage amplitude':'v(x,t)'}</text><text x="660" y="185">x →</text></svg><figcaption>Conceptual illustration · {standing?'ideal equal-wave lossless standing pattern':reflection?'directions and load reference plane':decay?'attenuating forward component':'uniform lossless line'} · not WaveLab measurement data.</figcaption>{travel&&<button type="button" class="text-button" data-wave-play aria-pressed="false" aria-controls={id}>Play conceptual wave</button>}</figure>
