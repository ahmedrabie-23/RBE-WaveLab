---
import {release,releaseView} from '../../../lib/release';
import Base from '../../../layouts/Base.astro';import {getCollection} from 'astro:content';import {href} from '../../../lib/paths';
const view=releaseView(release);
const entries=(await getCollection('faqs')).map(e=>({...e,data:{...e.data,answer:e.data.answer.replace('{{availability}}',view.canDownload?'An approved installer is identified on the Download page.':'RBE WaveLab V1.0.0 is published on GitHub; this website installer action is not activated.').replace('{{releaseAnswer}}',view.canDownload?`The Download page identifies approved ${release.stable!.version} metadata and its exact official installer. Compare its size and SHA-256, read the license and retain Windows protections.`:`${release.notice} ${release.knownLimitations}`)}}));
const schema={ '@type':'FAQPage', mainEntity:entries.map(e=>({ '@type':'Question',name:e.data.question,acceptedAnswer:{'@type':'Answer',text:e.data.answer} })) };
---
<Base title="FAQ and troubleshooting" description="Find clear answers about WaveLab's free V1.x policy, Windows target, offline workflows, result validity, local file formats and current release state." path="learn/faq/" schema={schema}><div class="container narrow"><header class="page-heading"><span class="eyebrow">Questions with precise boundaries</span><h1>FAQ & troubleshooting</h1><p class="lede">Start with the actual state, then find the guide that explains it.</p></header><section class="faq-list section" aria-label="Frequently asked questions">{entries.map(e=><details id={e.id}><summary>{e.data.question}</summary><p>{e.data.answer}</p><p><a href={href(e.data.path)}>Read the relevant guidance →</a></p></details>)}</section></div></Base>
