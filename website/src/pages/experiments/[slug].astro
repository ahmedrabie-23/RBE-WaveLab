---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
export async function getStaticPaths() { return (await getCollection('experiments')).map(entry=>({params:{slug:entry.id},props:{entry}})); }
const {entry}=Astro.props;const {Content}=await render(entry);
---
<Article {...entry.data} path={`experiments/${entry.id}/`}><Content/></Article>
