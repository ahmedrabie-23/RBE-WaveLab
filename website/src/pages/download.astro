---
import Base from '../layouts/Base.astro';
import {href} from '../lib/paths';
import {release,releaseView} from '../lib/release';
import published from '../data/published-release.json';
const view=releaseView(release);
const details=release.stable||{version:published.version,bytes:published.installer.bytes,sha256:published.installer.sha256,signature:published.installer.signature};
const label=view.canDownload?view.label:release.status==='suspended'?view.label:'Website download not activated';
---
<Base title="Download and release information" description="RBE WaveLab V1.0.0 official GitHub Release, Windows 11 x64 requirements, exact installer size and SHA-256, unsigned trust and qualification limits." path="download/">
 <div class="container"><header class="page-heading"><span class="eyebrow">Official distribution</span><h1>A clear release state.<br/>A deliberate download.</h1><p class="lede">RBE WaveLab V1.0.0 is published on GitHub. Desktop release availability and website publication are separate facts.</p></header>
 <div class="release-grid section"><section class="release-card" aria-labelledby="release-title"><span class="status" role="status">{label}</span><h2 id="release-title">RBE WaveLab V{details.version}</h2>
 <dl class="data-list"><dt>Desktop release</dt><dd>Published on GitHub · v1.0.0</dd><dt>Verified environment</dt><dd>{release.platform}</dd><dt>Release published</dt><dd><time datetime={published.releasePublicationTimestamp}>2026-11-08 20:55:53 UTC</time></dd><dt>Website deployment record</dt><dd>Recorded separately from this build</dd><dt>Installer</dt><dd><code>{published.installer.filename}</code></dd><dt>Installer size</dt><dd>{details.bytes.toLocaleString('en-US')} bytes</dd><dt>SHA-256</dt><dd><code>{details.sha256}</code></dd><dt>Signature</dt><dd>{details.signature} · no Authenticode Verified Publisher</dd></dl>
 {view.canDownload&&<a class="button" href={view.downloadURL!} data-installer-download>{view.label} ↓</a>}
 <p>{release.notice}</p><p><a href={published.releaseURL}>Open the official GitHub Release ↗</a></p>
 <p><a href={href('release-status/')}>Read release evidence and limitations</a></p></section>
 <aside><h2>Before installing</h2><ol class="steps"><li><strong>Use the official release</strong><p>Choose V1.0.0 and its accompanying User Materials, license and third-party notices. Internal RC installers are not substitutes.</p></li><li><strong>Compare the file</strong><p>Check the exact size and SHA-256. A matching checksum does not authenticate an unsigned publisher.</p></li><li><strong>Read the terms and warnings</strong><p>Read the <a href={href('license/')}>approved proprietary freeware license</a> before choosing I Agree. V1.x is free, including permitted commercial use. Keep antivirus, SmartScreen and Windows protections enabled; stop on a block.</p></li><li><strong>Check WebView2</strong><p>A compatible Microsoft WebView2 Runtime is required. The full signed offline prerequisite is embedded; clean-host/runtime/offline provisioning is untested.</p></li><li><strong>Preserve your work</strong><p>Back up valuable projects and use a permitted installation/storage location. Do not remove shared WebView2 or disable protection to work around an error.</p></li></ol></aside></div>
 <div class="grid grid-3 section"><a class="article-card" href={href('requirements/')}><h2>Requirements</h2><p>Windows 11 x64 evidence and WebView2 requirements.</p></a><a class="article-card" href={href('license/')}><h2>Application license</h2><p>Free V1.x, proprietary source and independent component rights.</p></a><a class="article-card" href={href('support/')}><h2>Need help?</h2><p>Best-effort community support; no response-time promise.</p></a></div></div>
</Base>
