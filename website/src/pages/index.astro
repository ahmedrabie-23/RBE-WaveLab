---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { href, github } from '../lib/paths';
import { person } from '../data/site';
import { release, releaseView } from '../lib/release';
import published from '../data/published-release.json';
const experiments=(await getCollection('experiments')).sort((a,b)=>a.data.order-b.data.order);
const features=[['A connected workbench','Configure a source, a physical line and a load. Place probes where a measurement has meaning.','learn/guides/workbench/'],['Four channels. One time reference.','Inspect steady-state voltage waveforms, measurements, trigger alignment and cursors.','learn/guides/oscilloscope/'],['From waveform to explanation','Use Plot Studio to examine current spatial, frequency and parameter curves.','learn/guides/plot-studio/']];
const view=releaseView(release);
const schema={ '@type':'SoftwareApplication',name:'RBE WaveLab',applicationCategory:'EducationalApplication',operatingSystem:'Windows 11 x64',description:'A proprietary freeware virtual laboratory for supported transmission-line engineering education.',creativeWorkStatus:'Desktop application published; website publication pending',softwareVersion:published.version,publisher:person,license:github+'/blob/main/LICENSE.txt' };
---
<Base title="Understand waves. Explore engineering." description="Explore transmission lines with RBE WaveLab: guided experiments, a four-channel Oscilloscope and scientific analysis. Free V1.x; desktop V1.0.0 published." schema={schema}>
 <section class="hero" data-home-section="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">A virtual laboratory for engineering</span><h1>Understand waves.<br/><span>Explore engineering.</span></h1><p>A free interactive virtual laboratory for exploring transmission-line behavior through guided experiments and engineering analysis.</p><div class="actions"><a class="button" href={href('experiments/')}>Explore the experiments <span aria-hidden="true">↗</span></a><a class="button secondary" href={href('download/')}>{view.canDownload?view.label:'Release information'}</a></div><div class="status">Windows 11 x64 verified environment · V{published.version} published on GitHub</div></div><div class="hero-media"><ProductImage id="workbench" eager/></div></div></section>
 <section class="container" aria-label="Configure simulate analyze" data-home-section="value"><div class="workflow-strip"><div><span class="step">01 / CONFIGURE</span><h2>Build a physical question.</h2><p>Choose the supported source, line and load. Set parameters with clear units.</p></div><div><span class="step">02 / SIMULATE</span><h2>Run a meaningful model.</h2><p>Calculate with the analytical RLGC engine. Manual mode waits for your Run.</p></div><div><span class="step">03 / ANALYZE</span><h2>Connect readings to theory.</h2><p>Compare instruments and current plots, then explain the behavior you observe.</p></div></div></section>
 <section class="section" data-home-section="features"><div class="container"><div class="section-top row"><div><span class="eyebrow">The instruments of understanding</span><h2>A focused lab,<br/>from setup to insight.</h2></div><a href={href('features/')}>Explore all features →</a></div><div class="grid grid-3">{features.map(([title,description,path])=><ArticleCard title={title} description={description} path={path}/>)}</div></div></section>
 <section class="section section-soft" data-home-section="experiments"><div class="container"><div class="section-top"><span class="eyebrow">Five guided experiments</span><h2>Start with a question.<br/>Follow the wave.</h2><p>Each experiment connects a physical interpretation, the relevant equations and a practical WaveLab workflow.</p></div><div class="grid grid-3">{experiments.map((e,i)=><ArticleCard title={e.data.title} description={e.data.description} path={`experiments/${e.id}/`} label="Experiment" number={String(i+1).padStart(2,'0')}/>)}</div></div></section>
 <section class="section" data-home-section="workflow"><div class="container split"><div><span class="eyebrow">How it works</span><h2>Observe. Change.<br/>Understand why.</h2><p class="lede">An experiment is more useful when you can explain how its configuration produces its result.</p><a href={href('learn/getting-started/')}>Follow your first experiment →</a></div><ol class="steps"><li><strong>Select an experiment</strong><p>Start preconfigured, assemble supplied equipment or begin with an empty setup.</p></li><li><strong>Configure source, line and load</strong><p>Use supported models, physical line positions and explicit units.</p></li><li><strong>Run the analysis</strong><p>Manual requires Run. Auto follows its normal update policy for physical edits.</p></li><li><strong>Inspect measurements</strong><p>Read probes, scope measurements, current curves and validity messages.</p></li><li><strong>Compare and interpret</strong><p>Predict the effect of a change, calculate again and check your reasoning.</p></li></ol><div class="video-panel full-span"><details><summary>Watch the actual desktop workflow · 18 seconds</summary><p>A genuine recording from the earlier RC5 candidate (not evidence of final Stable installation): choose Wave Propagation, start the preconfigured setup, Run, then inspect Plot Studio and the Oscilloscope. English captions describe the actions.</p><video controls preload="none" poster={href('media/workbench.webp')} width="1600" height="1000"><source src={href('media/wave-propagation-workflow.webm')} type="video/webm"/><track kind="captions" src={href('media/wave-propagation-workflow.vtt')} srclang="en" label="English action captions" default/>Your browser cannot play this WebM. The adjacent guide describes the same steps.</video><p><a href={href('learn/getting-started/')}>Read the complete text workflow</a></p></details></div></div></section>
 <section class="section section-soft" data-home-section="offline"><div class="container split"><div><span class="eyebrow">Free & offline-first</span><h2>Your experiment.<br/>Your local workspace.</h2><p>All V1.x releases and updates are free under the approved proprietary-freeware license, including educational, institutional, research and commercial use.</p><p>Local calculation and project workflows need no mandatory application account or product telemetry. GitHub participation and external services have their own internet, account and privacy requirements.</p><a href={href('privacy/')}>Understand the privacy boundaries →</a></div><div><ProductImage id="experiment-library"/><ul class="badge-list"><li>Local projects</li><li>No mandatory app account</li><li>English interface</li><li>Proprietary freeware</li></ul></div></div></section>
 <section class="section" data-home-section="community"><div class="container split"><div><span class="eyebrow">Learning is a conversation</span><h2>Bring your questions<br/>to the community.</h2><p>Discuss transmission-line concepts, share nonconfidential learning examples and help improve the documentation. Report reproducible technical problems through Issues.</p><div class="actions"><a class="button secondary" href={github+'/discussions'}>Join Discussions ↗</a><a href={href('community/')} class="text-button">Find the right channel</a></div></div><div class="callout"><h3>Curiosity is welcome.</h3><p>Support is community-based and best-effort. Never share passwords, confidential projects or proprietary engineering data in public posts.</p></div></div></section>
 <section class="container section" data-home-section="final"><div class="final-cta"><div><span class="eyebrow">A clear next step</span><h2>Choose a concept.<br/>Make it tangible.</h2><p>Start learning now; check the Download page for the honest application release state.</p></div><div class="actions"><a class="button" href={href('learn/')}>Enter the learning hub →</a><a class="button secondary" href={href('download/')}>Download status</a></div></div></section>
</Base>
