---
import Base from '../layouts/Base.astro';import {getEntry,render} from 'astro:content';import {policies,github} from '../data/site';
export function getStaticPaths(){return policies.map(policy=>({params:{policy:policy.slug},props:{policy}}));}
const {policy}=Astro.props;const entry=await getEntry('policies',policy.id);if(!entry)throw new Error(`Authoritative policy missing: ${policy.id}`);const {Content}=await render(entry);
---
<Base title={policy.title} description={policy.description} path={`${policy.slug}/`}><div class="container narrow"><header class="page-heading"><span class="eyebrow">Authoritative product documentation</span><h1>{policy.title}</h1><p class="lede">{policy.description}</p></header><article class="article-body section"><Content/>{policy.slug==='privacy'&&<section><h2>This website's local preference</h2><p>This website candidate uses local storage only for your optional theme choice. It has no tracking analytics, advertising scripts, mandatory accounts or hidden feedback submission. Hosting, browsers and external services have independent behavior. Clearing the theme choice restores the system preference.</p></section>}<p class="policy-source">Rendered from the authoritative product document, not an independently rewritten policy. <a href={`${github}/blob/main/${policy.source}`}>View the official document ↗</a></p></article></div></Base>
