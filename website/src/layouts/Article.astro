---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductImage from '../components/ProductImage.astro';
import WaveDiagram from '../components/WaveDiagram.astro';
import { canonical, href } from '../lib/paths';
import { person } from '../data/site';
interface Props { title:string; description:string; path:string; kind:'experiment'|'guide'|'concept'; level:string; readingMinutes:number; image?:string; related:string[]; updated:string; }
const { title,description,path,kind,level,readingMinutes,image,related,updated }=Astro.props;
const parent=kind==='experiment'?{title:'Experiments',path:'experiments/'}:{title:'Learn',path:'learn/'};
const schema=[{ '@type':kind==='experiment'?'LearningResource':'TechArticle', headline:title, name:title, description, url:canonical(path), inLanguage:'en', author:person, publisher:person, dateModified:updated, learningResourceType:kind==='experiment'?'Guided experiment':'Reference guide', creativeWorkStatus:'Educational reference for the published RBE WaveLab V1.0.0 desktop release' },{ '@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:canonical() },{ '@type':'ListItem',position:2,name:parent.title,item:canonical(parent.path) },{ '@type':'ListItem',position:3,name:title,item:canonical(path) }] }];
---
<Base title={title} description={description} path={path} schema={schema}><div class="container"><Breadcrumbs items={[parent,{title,path}]}/><header class="page-heading"><span class="eyebrow">{level} / {kind==='experiment'?'Guided experiment':kind==='guide'?'User guide':'Engineering concept'}</span><h1>{title}</h1><p class="lede">{description}</p><div class="article-meta">{readingMinutes} min read · content prepared {updated} · steady-state CW scope</div></header><div class="article-layout"><article class="article-body">{image&&<ProductImage id={image}/>}<slot/>{kind==='experiment'&&<WaveDiagram mode={path.split("/")[1]} id={`illustration-${path.replaceAll('/','-')}`}/>}<p class="policy-source">© 2026 Ahmed Rabie. Original explanation: All Rights Reserved. Scientific facts and formulas are not claimed as exclusive property. <a href={href('website-rights/')}>Rights and attribution</a>.</p></article><aside class="article-side"><h2>Continue learning</h2><a href={href('learn/getting-started/')}>Start your first experiment</a>{related.map(p=><a href={href(p)}>{p.split('/').filter(Boolean).at(-1)?.replaceAll('-',' ')}</a>)}<a href={href('scientific-scope/')}>Scientific scope</a><a href={href('download/')}>Application release status</a><div class="callout"><p>WaveLab V1 reconstructs steady-state waveforms. This website does not run a separate engineering simulator.</p></div></aside></div></div></Base>
